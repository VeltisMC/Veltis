+        public void release() {
+            synchronized (this) {
+                closing = true;
+                if (lifecycle == LIFECYCLE_ACTIVE) {
+                    lifecycle = LIFECYCLE_CLOSING;
+                }
+                while (phase != null && ownerThread != Thread.currentThread()) {
+                    try {
+                        wait();
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        // Do not clear state a live worker may still reference; mark the
+                        // release pending and let endPhase do it.
+                        releasePending = true;
+                        return;
+                    }
+                }
+                if (phase != null) {
+                    // Close was requested by the phase's own owner thread.
+                    releasePending = true;
+                    return;
+                }
+                finishReleaseLocked();
+            }
+        }
+
+        private void finishReleaseLocked() {
+            if (released) {
+                return;
+            }
+            released = true;
+            releasePending = false;
+            lifecycle = LIFECYCLE_CLOSED;
+            closing = true;
+            ownerThread = null;
+            wireHandlers.clear();
+            scratch.global.clear();
+            scratch.chunks.clear();
+            scratch.regionMap.clear();
+            scratch.dispatch.clear();
+            scratch.indexOf.clear();
+            scratch.regions.clear();
+            scratch.keys.clear();
+        }
+    }
+
+    public static final class Phase {
+        public static final int STATE_ACTIVE = 0;
+        public static final int STATE_DRAINING = 1;
+        public static final int STATE_CLOSED = 2;
+
+        /** Identity of a due block tick: vanilla's UNIQUE_TICK_HASH is (type identity, pos). */
+        public record TickKey(long pos, Block type) {
+        }
+
+        public final ServerLevel level;
+        public final LevelTicks<Block> blockTicks;
+        public final ConcurrentLinkedQueue<Runnable> deferred = new ConcurrentLinkedQueue<>();
+        public final ConcurrentHashMap<TickKey, Boolean> remaining = new ConcurrentHashMap<>();
+        public final AtomicReference<Throwable> failure = new AtomicReference<>();
+        public final ConcurrentLinkedQueue<ScheduledTick<Block>> executed = new ConcurrentLinkedQueue<>();
+        public final AtomicInteger state = new AtomicInteger(STATE_ACTIVE);
+        public final Object admissionLock = new Object();
+        public volatile boolean admissionOpen = true;
+
+        public Phase(final ServerLevel level, final LevelTicks<Block> blockTicks, final int taskCount) {
+            this.level = level;
+            this.blockTicks = blockTicks;
+        }
+
+        /**
+         * Atomically admits one deferred operation. Returns false once admission has been
+         * closed, in which case the caller must use its immediate fallback path.
+         */
+        public boolean offer(final Runnable op) {
+            synchronized (this.admissionLock) {
+                if (!this.admissionOpen || this.state.get() != STATE_ACTIVE) {
+                    return false;
+                }
+                this.deferred.add(op);
+                return true;
+            }
+        }
+
+        /** Atomically stops admission; draining follows on the owner thread. */
+        public void closeAdmission() {
+            synchronized (this.admissionLock) {
+                this.admissionOpen = false;
+                this.state.set(STATE_DRAINING);
+            }
+        }
+    }
+
+    public static final class PhaseContext {
+        public final ServerLevel level;
+        public final LevelState state;
+        public final Phase phase;
+
+        public PhaseContext(final ServerLevel level, final LevelState state, final Phase phase) {
+            this.level = level;
+            this.state = state;
+            this.phase = phase;
+        }
+    }
+
+    private static ExecutorService pool() {
+        if (pool == null) {
+            synchronized (ParallelRedstone.class) {
+                if (pool == null) {
+                    ThreadFactory factory = runnable -> {
+                        Thread thread = new Thread(runnable, "Veltis-ParallelRedstone");
+                        thread.setDaemon(true);
+                        return thread;
+                    };
+                    pool = Executors.newFixedThreadPool(WORKER_THREADS, factory);
+                }
+            }
+        }
+        return pool;
+    }
+
+    // ---------------------------------------------------------------------
+    // Entry point - drop-in replacement for LevelTicks#tick
+    // ---------------------------------------------------------------------
+
+    public static void tickBlockTicks(final ServerLevel level, final long tick, final int maxTicks) {
+        ProfilerFiller profiler = Profiler.get();
+        profiler.push("collect");
+        long collectStart = System.nanoTime();
+        level.blockTicks.collectTicks(tick, maxTicks, profiler);
+        statCollectNanos.addAndGet(System.nanoTime() - collectStart);
+        profiler.popPush("run");
+        profiler.incrementCounter("ticksToRun", level.blockTicks.toRunThisTick.size());
+        LevelState state = LevelState.of(level);
+        if (state.closing) {
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            level.blockTicks.cleanupAfterTick();
+            profiler.pop();
+            maybeLogStats();
+            return;
+        }
+        try {
+            run(level, state);
+        } finally {
+            profiler.popPush("cleanup");
+            level.blockTicks.cleanupAfterTick();
+            profiler.pop();
+            maybeLogStats();
+        }
+    }
+
+    private static void run(final ServerLevel level, final LevelState state) {
+        Queue<ScheduledTick<Block>> pending = level.blockTicks.toRunThisTick;
+        if (!ENABLED) {
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+        if (pending.size() < MIN_TICKS_FOR_PARALLEL) {
+            // Dispatching tiny tick counts costs more than it saves.
+            statSerialSmall.incrementAndGet();
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+
+        // Only the audited vanilla workload may run on workers. Checking the collected
+        // types (rather than the blocks a handler later touches) is the first line of the
+        // audit: a custom block's tick, fire spread, crop growth, command blocks, etc.
+        // never reach a worker, no matter how far they are from other work.
+        for (ScheduledTick<Block> entry : pending) {
+            if (!isAuditedTickType(entry.type())) {
+                statSerialUnauditedTick.incrementAndGet();
+                level.blockTicks.runCollectedTicks(level::tickBlock);
+                return;
+            }
+        }
+
+        // Global list in the exact vanilla drain order - the authoritative ordering for
+        // everything below (region contents keep their relative vanilla order), plus the
+        // set of distinct pending chunk columns. Scratch, cleared before filling.
+        long groupStart = System.nanoTime();
+        Scratch scratch = state.scratch;
+        List<ScheduledTick<Block>> global = scratch.global;
+        global.clear();
+        global.addAll(pending);
+        LongOpenHashSet chunks = scratch.chunks;
+        chunks.clear();
+        for (ScheduledTick<Block> entry : global) {
+            chunks.add(ChunkPos.pack(entry.pos()));
+        }
+        statGroupNanos.addAndGet(System.nanoTime() - groupStart);
+
+        if (chunks.size() < 2) {
+            // All pending work sits in a single chunk column; there is nothing to split.
+            statSerialSingleChunk.incrementAndGet();
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+
+        statEvaluated.incrementAndGet();
+        statPendingSum.addAndGet(pending.size());
+        long clusterStart = System.nanoTime();
+        Long2IntMap chunkRegion = computeRegions(level, state, chunks);
+        statClusterNanos.addAndGet(System.nanoTime() - clusterStart);
+        if (chunkRegion == null) {
+            // Conservative fallback: exact vanilla serial execution.
+            statSerialUnverified.incrementAndGet();
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+
+        long workListStart = System.nanoTime();
+        Long2ObjectOpenHashMap<List<ScheduledTick<Block>>> regionMap = scratch.regionMap;
+        regionMap.clear();
+        for (ScheduledTick<Block> entry : global) {
+            int regionId = chunkRegion.get(ChunkPos.pack(entry.pos()));
+            List<ScheduledTick<Block>> region = regionMap.get(regionId);
+            if (region == null) {
+                region = new ArrayList<>();
+                regionMap.put(regionId, region);
+            }
+            region.add(entry);
+        }
+        statWorkListNanos.addAndGet(System.nanoTime() - workListStart);
+        if (regionMap.size() < 2) {
+            // Clustering proves a single region - running it in parallel cannot help.
+            statSerialSingleRegion.incrementAndGet();
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+
+        // Largest first: workers pull regions from a shared cursor, so starting the
+        // biggest region first keeps the tail (only the largest region still running)
+        // as short as possible. Cross-region execution order is already nondeterministic
+        // (concurrent consumers) and each region's internal order comes from the global
+        // drain list, so the sort cannot change observable behavior.
+        List<List<ScheduledTick<Block>>> dispatch = scratch.dispatch;
+        dispatch.clear();
+        dispatch.addAll(regionMap.values());
+        dispatch.sort((a, b) -> Integer.compare(b.size(), a.size()));
+
+        // Snapshot region statistics before execution: a concurrent close may release the
+        // scratch structures as soon as the phase ends.
+        int regionTotal = regionMap.size();
+        int regionMax = 0;
+        for (List<ScheduledTick<Block>> region : regionMap.values()) {
+            regionMax = Math.max(regionMax, region.size());
+        }
+
+        long phaseStart = System.nanoTime();
+        boolean admitted = executeRegions(level, state, global, dispatch);
+        statPhaseNanos.addAndGet(System.nanoTime() - phaseStart);
+        if (!admitted) {
+            // Shutdown began between clustering and admission: run the exact vanilla path.
+            level.blockTicks.runCollectedTicks(level::tickBlock);
+            return;
+        }
+
+        statParallel.incrementAndGet();
+        statRegionSum.addAndGet(regionTotal);
+        long rm = statRegionsMax.get();
+        if (regionTotal > rm) {
+            statRegionsMax.compareAndSet(rm, regionTotal);
+        }
+        long rmt = statRegionMaxTicks.get();
+        if (regionMax > rmt) {
+            statRegionMaxTicks.compareAndSet(rmt, regionMax);
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Region formation - clustering over pending chunks
+    // ---------------------------------------------------------------------
+
+    /**
+     * Source of a chunk's unbounded-propagator positions during region discovery;
+     * {@code null} marks a chunk that is not loaded. Extracted from {@link ServerLevel}
+     * so the discovery algorithm can be tested against a reference implementation.
+     */
+    @FunctionalInterface
+    interface PropagatorSource {
+        @Nullable LongOpenHashSet propagatorsOf(int chunkX, int chunkZ);
+
+        /**
+         * Whether the chunk contains only passive or vanilla-reactive blocks, i.e. no
+         * block that can run a third-party reactive callback. Defaults to true so the
+         * distance-model tests can keep supplying a propagator-only source; production
+         * always overrides it with the real neighbourhood audit.
+         */
+        default boolean neighbourhoodSafe(int chunkX, int chunkZ) {
+            return true;
+        }
+    }
+
+    /**
+     * Groups pending-tick chunks into independent regions. Returns a chunk-key to region-id
+     * map, or {@code null} when the tick must run on the exact vanilla serial path.
+     *
+     * <p>Rule A unions pending chunks within Chebyshev distance 2 (their bounded halos can
+     * share a chunk column). Rule B discovers every unbounded-propagator component reachable
+     * from the 25-chunk window around a pending chunk, anchors each component to the pending
+     * chunks that can reach it, and unions components whose position columns sit within
+     * Chebyshev distance 2 of each other. Because a component's reads and writes stay within
+     * 16 blocks of its positions (and a tick's within 16 blocks of its position), disjoint
+     * regions after these merges read and write disjoint chunk sets.</p>
+     *
+     * <p>Server-thread only; every pending chunk must be a key of the result map.</p>
+     */
+    private static @Nullable Long2IntMap computeRegions(final ServerLevel level, final LevelState state, final LongSet pendingChunks) {
+        final PropagatorSource source = new PropagatorSource() {
+            @Override
+            public @Nullable LongOpenHashSet propagatorsOf(final int chunkX, final int chunkZ) {
+                LevelChunk chunk = level.chunkSource.getChunkNow(chunkX, chunkZ);
+                return chunk == null ? null : unboundedPropagatorsOf(chunk);
+            }
+
+            @Override
+            public boolean neighbourhoodSafe(final int chunkX, final int chunkZ) {
+                LevelChunk chunk = level.chunkSource.getChunkNow(chunkX, chunkZ);
+                return chunk != null && chunkNeighbourhoodSafe(chunk);
+            }
+        };
+        return computeRegions(state.scratch, pendingChunks, source);
+    }
+
+    /**
+     * Pure discovery core over an injected {@link PropagatorSource}. Uses scratch state
+     * (cleared on entry, retained capacity across calls) and is server-thread only, like
+     * {@link #run(ServerLevel)}.
+     */
+    static @Nullable Long2IntMap computeRegions(final LongSet pendingChunks, final PropagatorSource source) {
+        synchronized (TEST_SCRATCH_LOCK) {
+            return computeRegions(TEST_SCRATCH, pendingChunks, source);
+        }
+    }
+
+    static @Nullable Long2IntMap computeRegions(final Scratch scratch, final LongSet pendingChunks, final PropagatorSource source) {
+        int size = pendingChunks.size();
+        Long2IntMap indexOf = scratch.indexOf;
+        indexOf.clear();
+        LongList keys = scratch.keys;
+        keys.clear();
+        int[] parent = scratch.parent;
+        if (parent.length < size) {
+            parent = new int[size];
+            scratch.parent = parent;
+        }
+        int index = 0;
+        for (long key : pendingChunks) {
+            indexOf.put(key, index);
+            keys.add(key);
+            parent[index] = index;
+            index++;
+        }
+
+        RegionFinder finder = scratch.finder;
+        finder.reset(source, parent);
+
+        for (int i = 0; i < size; i++) {
+            long key = keys.getLong(i);
+            int centerX = ChunkPos.getX(key);
+            int centerZ = ChunkPos.getZ(key);
+
+            for (int dx = -2; dx <= 2; dx++) {
+                for (int dz = -2; dz <= 2; dz++) {
+                    int chunkX = centerX + dx;
+                    int chunkZ = centerZ + dz;
+                    long candidate = ChunkPos.pack(chunkX, chunkZ);
+
+                    if ((dx != 0 || dz != 0) && indexOf.get(candidate) != -1) {
+                        finder.unionPending(i, indexOf.get(candidate));
+                    }
+
+                    // Every column in the 5x5 window can receive a synchronous block
+                    // update from this pending tick (or from the first hop of its
+                    // neighbour cascade), so any block there that overrides a reactive
+                    // callback from outside the vanilla platform disqualifies the phase.
+                    if (!finder.neighbourhoodSafe(chunkX, chunkZ)) {
+                        statSerialUnsafeNeighbourhood.incrementAndGet();
+                        return null;
+                    }
+
+                    LongOpenHashSet propagators = finder.propagatorsOf(chunkX, chunkZ);
+                    if (propagators == null) {
+                        // A column within side-effect reach of pending work is not loaded:
+                        // vanilla could sync-load it at any point during the tick. Refuse to
+                        // parallelize rather than risk a mid-phase load.
+                        return null;
+                    }
+                    if (propagators.isEmpty()) {
+                        continue;
+                    }
+
+                    for (long position : propagators) {
+                        int component = finder.componentOf(position);
+                        if (component < 0) {
+                            // Component unverifiable (a chunk inside the network is
+                            // missing), oversized, or touching an unsafe neighbourhood -
+                            // exact vanilla serial path.
+                            if (finder.unsafeNeighbourhood) {
+                                statSerialUnsafeNeighbourhood.incrementAndGet();
+                            }
+                            return null;
+                        }
+                        finder.anchor(i, component);
+                    }
+                }
+            }
+        }
+
+        // Two components whose position columns reach within Chebyshev 2 of each other read
+        // and write overlapping chunk columns; they must run in the same region.
+        finder.mergeNearbyComponents();
+
+        Long2IntMap regions = scratch.regions;
+        regions.clear();
+        for (int i = 0; i < size; i++) {
+            regions.put(keys.getLong(i), finder.find(i));
+        }
+        return regions;
+    }
+
+    private static final class RegionFinder {
+        /**
+         * Directions for 6-connected walks over packed positions. Propagator networks are
+         * connected through direct block adjacency in all six directions.
+         */
+        private static final int[] X_STEP = {1, -1, 0, 0, 0, 0};
+        private static final int[] Y_STEP = {0, 0, 1, -1, 0, 0};
+        private static final int[] Z_STEP = {0, 0, 0, 0, 1, -1};
+
+        /**
+         * Reused across ticks (scratch, cleared on {@link #reset}); capacity retention is
+         * bounded by the largest network seen so far, comparable to vanilla's per-chunk
+         * caches.
+         */
+        final Long2ObjectOpenHashMap<LongOpenHashSet> propagatorsByChunk = new Long2ObjectOpenHashMap<>();
+        /** Propagator position -> id of the component it was discovered in. */
+        final Long2IntMap positionComponent = new Long2IntOpenHashMap();
+        /** Chunk column -> id of the first component that claimed a position there. */
+        final Long2IntMap columnComponent = new Long2IntOpenHashMap();
+        /** Component root -> pending index that first anchored it. */
+        final Long2IntMap componentAnchor = new Long2IntOpenHashMap();
+        /** Per-pass cache of the neighbourhood audit: -1 unknown, 0 unsafe, 1 safe. */
+        final Long2ByteOpenHashMap safetyByChunk = new Long2ByteOpenHashMap();
+        /** Component chunks whose 5x5 halo has already been verified this pass. */
+        final LongOpenHashSet verifiedHalos = new LongOpenHashSet();
+        /** Set when discovery had to stop because of an unsafe block in reach. */
+        boolean unsafeNeighbourhood;
+        int[] componentParent = new int[64];
+        int componentCount;
+
+        PropagatorSource source;
+        int[] parent;
+
+        RegionFinder() {
+            this.positionComponent.defaultReturnValue(-1);
+            this.columnComponent.defaultReturnValue(-1);
+            this.componentAnchor.defaultReturnValue(-1);
+            this.safetyByChunk.defaultReturnValue((byte)-1);
+        }
+
+        /** Prepares the scratch finder for a new discovery pass. */
+        void reset(final PropagatorSource source, final int[] parent) {
+            this.source = source;
+            this.parent = parent;
+            this.propagatorsByChunk.clear();
+            this.positionComponent.clear();
+            this.columnComponent.clear();
+            this.componentAnchor.clear();
+            this.safetyByChunk.clear();
+            this.verifiedHalos.clear();
+            this.unsafeNeighbourhood = false;
+            this.componentCount = 0;
+        }
+
+        /** Cached per-pass neighbourhood audit for one chunk column. */
+        boolean neighbourhoodSafe(final int chunkX, final int chunkZ) {
+            long key = ChunkPos.pack(chunkX, chunkZ);
+            byte cached = this.safetyByChunk.get(key);
+            if (cached != -1) {
+                return cached == 1;
+            }
+            boolean safe = this.source.neighbourhoodSafe(chunkX, chunkZ);
+            this.safetyByChunk.put(key, (byte)(safe ? 1 : 0));
+            return safe;
+        }
+
+        /**
+         * Verifies the 5x5 columns around a component position. A propagator handler
+         * writes within 16 blocks (one column) and the block update it emits notifies the
+         * six neighbours of the written position (one more column), so the whole 5x5
+         * window can run a reactive callback. Checking it for every component chunk -
+         * not just the initial pending window - closes the "chain reaches a distant
+         * custom block" hole without resorting to an unbounded global scan.
+         */
+        boolean verifyComponentHalo(final long position) {
+            int chunkX = BlockPos.getX(position) >> 4;
+            int chunkZ = BlockPos.getZ(position) >> 4;
+            if (!this.verifiedHalos.add(ChunkPos.pack(chunkX, chunkZ))) {
+                return true;
+            }
+            for (int dx = -2; dx <= 2; dx++) {
+                for (int dz = -2; dz <= 2; dz++) {
+                    if (!this.neighbourhoodSafe(chunkX + dx, chunkZ + dz)) {
+                        this.unsafeNeighbourhood = true;
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
+
+        int find(int i) {
+            while (parent[i] != i) {
+                parent[i] = parent[parent[i]];
+                i = parent[i];
+            }
+            return i;
+        }
+
+        void unionPending(int a, int b) {
+            int rootA = find(a);
+            int rootB = find(b);
+            if (rootA != rootB) {
+                parent[Math.max(rootA, rootB)] = Math.min(rootA, rootB);
+            }
+        }
+
+        int componentFind(int id) {
+            while (componentParent[id] != id) {
+                componentParent[id] = componentParent[componentParent[id]];
+                id = componentParent[id];
+            }
+            return id;
+        }
+
+        void componentUnion(int a, int b) {
+            int rootA = componentFind(a);
+            int rootB = componentFind(b);
+            if (rootA == rootB) {
+                return;
+            }
+
+            int anchorA = componentAnchor.get(rootA);
+            int anchorB = componentAnchor.get(rootB);
+            componentParent[rootB] = rootA;
+            if (anchorA != -1 && anchorB != -1) {
+                unionPending(anchorA, anchorB);
+            } else if (anchorA == -1 && anchorB != -1) {
+                componentAnchor.put(rootA, anchorB);
+            }
+            componentAnchor.remove(rootB);
+        }
+
+        /**
+         * Returns the unbounded-propagator positions of a chunk, or {@code null} when the
+         * chunk is not loaded. Results are cached for the duration of the tick, and each
+         * chunk's set itself is cached (volatile, invalidated only on propagator membership
+         * changes) across ticks by {@link #unboundedPropagatorsOf(LevelChunk)}.
+         */
+        LongOpenHashSet propagatorsOf(final int chunkX, final int chunkZ) {
+            long key = ChunkPos.pack(chunkX, chunkZ);
+            LongOpenHashSet cached = this.propagatorsByChunk.get(key);
+            if (cached != null) {
+                return cached;
+            }
+
+            cached = this.source.propagatorsOf(chunkX, chunkZ);
+            if (cached == null) {
+                return null;
+            }
+
+            this.propagatorsByChunk.put(key, cached);
+            return cached;
+        }
+
+        /**
+         * Returns the component containing the given propagator position, flood-filling its
+         * whole 6-connected network on first use, or -1 when the component cannot be
+         * verified (an unloaded chunk inside it) or exceeds the position cap. Two discovery
+         * walks can never meet: a completed walk claims every position of its component, so
+         * a start position already claimed simply returns the existing component.
+         */
+        int componentOf(final long startPosition) {
+            int existing = this.positionComponent.get(startPosition);
+            if (existing != -1) {
+                return componentFind(existing);
+            }
+
+            int componentId = this.componentCount++;
+            if (this.componentCount > this.componentParent.length) {
+                this.componentParent = Arrays.copyOf(this.componentParent, Math.max(this.componentParent.length * 2, this.componentCount));
+            }
+            this.componentParent[componentId] = componentId;
+
+            LongList frontier = new LongArrayList();
+            frontier.add(startPosition);
+            this.positionComponent.put(startPosition, componentId);
+            this.claimColumn(componentId, startPosition);
+            if (!this.verifyComponentHalo(startPosition)) {
+                return -1;
+            }
+
+            for (int head = 0; head < frontier.size(); head++) {
+                long position = frontier.getLong(head);
+                int x = BlockPos.getX(position);
+                int y = BlockPos.getY(position);
+                int z = BlockPos.getZ(position);
+
+                for (int direction = 0; direction < 6; direction++) {
+                    int neighborX = x + X_STEP[direction];
+                    int neighborY = y + Y_STEP[direction];
+                    int neighborZ = z + Z_STEP[direction];
+                    long neighbor = BlockPos.asLong(neighborX, neighborY, neighborZ);
+                    if (this.positionComponent.containsKey(neighbor)) {
+                        continue;
+                    }
+
+                    LongOpenHashSet propagators = this.propagatorsOf(neighborX >> 4, neighborZ >> 4);
+                    if (propagators == null) {
+                        return -1;
+                    }
+                    if (!propagators.contains(neighbor)) {
+                        continue;
+                    }
+                    if (frontier.size() >= MAX_COMPONENT_POSITIONS) {
+                        return -1;
+                    }
+
+                    this.positionComponent.put(neighbor, componentId);
+                    this.claimColumn(componentId, neighbor);
+                    if (!this.verifyComponentHalo(neighbor)) {
+                        return -1;
+                    }
+                    frontier.add(neighbor);
+                }
+            }
+
+            return componentFind(componentId);
+        }
+
+        void claimColumn(final int componentId, final long position) {
+            long column = ChunkPos.pack(BlockPos.getX(position) >> 4, BlockPos.getZ(position) >> 4);
+            int existing = this.columnComponent.get(column);
+            if (existing == -1) {
+                this.columnComponent.put(column, componentId);
+            } else if (existing != componentId) {
+                // Two distinct components hold positions in the same column.
+                componentUnion(existing, componentId);
+            }
+        }
+
+        /** Anchors a component to pending chunk {@code pendingIndex}, merging regions. */
+        void anchor(final int pendingIndex, final int component) {
+            int root = componentFind(component);
+            int anchor = this.componentAnchor.get(root);
+            if (anchor == -1) {
+                this.componentAnchor.put(root, pendingIndex);
+            } else {
+                unionPending(pendingIndex, anchor);
+            }
+        }
+
+        /**
+         * Unions every pair of components whose position columns are within Chebyshev
+         * distance 2 of each other: such components have overlapping side-effect halos
+         * (positions &plusmn;16 blocks = columns &plusmn;1) and must never run apart.
+         */
+        void mergeNearbyComponents() {
+            for (Long2IntMap.Entry entry : this.columnComponent.long2IntEntrySet()) {
+                long column = entry.getLongKey();
+                int componentId = entry.getIntValue();
+                int centerX = ChunkPos.getX(column);
+                int centerZ = ChunkPos.getZ(column);
+
+                for (int dx = -2; dx <= 2; dx++) {
+                    for (int dz = -2; dz <= 2; dz++) {
+                        int other = this.columnComponent.get(ChunkPos.pack(centerX + dx, centerZ + dz));
+                        if (other != -1 && other != componentId) {
+                            componentUnion(componentId, other);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Region execution
+    // ---------------------------------------------------------------------
+
+    /**
+     * Dispatches the regions on the worker pool. Returns {@code false} when the level is
+     * closing and no phase could be admitted (the caller must run the serial path).
+     */
+    private static boolean executeRegions(final ServerLevel level, final LevelState state, final List<ScheduledTick<Block>> global, final List<List<ScheduledTick<Block>>> regions) {
+        int regionCount = regions.size();
+        Phase phase = state.beginPhase(level.blockTicks, regionCount);
+        if (phase == null) {
+            return false;
+        }
+        AtomicInteger cursor = new AtomicInteger();
+        final AtomicInteger remainingTasks = new AtomicInteger(1); // server thread
+
+        for (ScheduledTick<Block> t : global) {
+            phase.remaining.put(new Phase.TickKey(t.pos().asLong(), t.type()), Boolean.TRUE);
+        }
+
+        Runnable body = () -> {
+            PhaseContext prev = CONTEXT.get();
+            CONTEXT.set(new PhaseContext(level, state, phase));
+            try {
+                int next;
+                while (phase.failure.get() == null && (next = cursor.getAndIncrement()) < regionCount) {
+                    runRegion(phase, regions.get(next), level::tickBlock);
+                }
+            } finally {
+                CONTEXT.set(prev);
+                remainingTasks.decrementAndGet();
+            }
+        };
+
+        ACTIVE_PHASES.incrementAndGet();
+        try {
+            long dispatchStart = System.nanoTime();
+            for (int worker = 0; worker < WORKER_THREADS; worker++) {
+                // Increment before submit: the worker may finish before submit returns.
+                remainingTasks.incrementAndGet();
+                try {
+                    pool().submit(body);
+                } catch (Throwable t) {
+                    remainingTasks.decrementAndGet();
+                    phase.failure.compareAndSet(null, t);
+                }
+            }
+            statDispatchNanos.addAndGet(System.nanoTime() - dispatchStart);
+
+            long workStart = System.nanoTime();
+            body.run();
+            statWorkNanos.addAndGet(System.nanoTime() - workStart);
+
+            long barrierStart = System.nanoTime();
+            Throwable barrierFailure = awaitQuiescence(level, remainingTasks);
+            if (barrierFailure != null) {
+                recordFailure(phase, barrierFailure);
+            }
+            statBarrierNanos.addAndGet(System.nanoTime() - barrierStart);
+        } finally {
+            ACTIVE_PHASES.decrementAndGet();
+            // Unconditionally prove quiescence before any cleanup, including the dispatch
+            // failure path. A main-thread task that throws must not let us drain while a
+            // worker still holds a chunk, a wire handler or a deferred reference.
+            Throwable quiescenceFailure = awaitQuiescence(level, remainingTasks);
+            if (quiescenceFailure != null) {
+                recordFailure(phase, quiescenceFailure);
+            }
+            try {
+                long drainStart = System.nanoTime();
+                // Move the bookkeeping to the exact state vanilla would present after
+                // runCollectedTicks returns: the collected queue and its identity set are
+                // empty and every tick that ran is in alreadyRunThisTick. This must happen
+                // before the drain so that a deferred callback querying willTickThisTick
+                // observes post-run semantics rather than "every tick is still queued".
+                level.blockTicks.toRunThisTick.clear();
+                level.blockTicks.toRunThisTickSet.clear();
+                level.blockTicks.alreadyRunThisTick.addAll(phase.executed);
+                int deferredCount = drainDeferred(phase);
+                statDeferredSum.addAndGet(deferredCount);
+                statDrainNanos.addAndGet(System.nanoTime() - drainStart);
+            } finally {
+                // Always unregister the phase, even when draining throws; this is what
+                // lets a concurrent shutdown proceed instead of spinning forever.
+                state.endPhase(phase);
+            }
+        }
+
+        Throwable thrown = phase.failure.get();
+        if (thrown != null) {
+            if (thrown instanceof RuntimeException runtimeException) {
+                throw runtimeException;
+            }
+            if (thrown instanceof Error error) {
+                throw error;
+            }
+            throw new RuntimeException(thrown);
+        }
+        return true;
+    }
+
+    /**
+     * Waits until every submitted worker has decremented {@code remainingTasks}, pumping
+     * main-thread chunk tasks while it waits. This is a hard quiescence proof, not a
+     * best-effort wait: an interrupt is recorded and the wait continues (the flag is
+     * restored before returning), and a throwing main-thread task is recorded but does not
+     * let the caller proceed while workers remain. Every failure observed here is returned
+     * so the caller can attach it to the phase failure without a race.
+     */
+    private static @Nullable Throwable awaitQuiescence(final ServerLevel level, final AtomicInteger remainingTasks) {
+        return awaitQuiescence(
+            remainingTasks,
+            () -> level.chunkSource.mainThreadProcessor.managedBlock(() -> remainingTasks.get() == 0));
+    }
+
+    /**
+     * Testable core of {@link #awaitQuiescence(ServerLevel, AtomicInteger)}: {@code pump}
+     * is the main-thread work pump (the real one polls the chunk executor). Visibility is
+     * package-private so lifecycle tests can prove the interrupt and throw semantics
+     * without needing a live server.
+     */
+    static @Nullable Throwable awaitQuiescence(final AtomicInteger remainingTasks, final Runnable pump) {
+        Throwable first = null;
+        boolean interrupted = false;
+        while (remainingTasks.get() != 0) {
+            try {
+                pump.run();
+            } catch (Throwable t) {
+                if (first == null) {
+                    first = t;
+                } else if (first != t) {
+                    try {
+                        first.addSuppressed(t);
+                    } catch (Throwable ignored) {
+                        // Suppression is best effort; the primary failure is retained.
+                    }
+                }
+            }
+            if (Thread.interrupted()) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+        return first;
+    }
+
+    /**
+     * Closes admission and drains every already-accepted deferred operation. Because the
+     * close and every offer share {@link Phase#admissionLock}, a producer either completed
+     * its enqueue before the close (and is observed by this loop) or is rejected. Nested
+     * work produced by a drained callback is rejected by the closed gate and therefore
+     * runs inline on the calling (server) thread, which is exactly the required fallback.
+     * No lock is held while callbacks run. Returns the number executed.
+     */
+    static int drainDeferred(final Phase phase) {
+        phase.closeAdmission();
+        int deferredCount = 0;
+        Runnable deferred;
+        do {
+            while ((deferred = phase.deferred.poll()) != null) {
+                deferredCount++;
+                try {
+                    deferred.run();
+                } catch (Throwable t) {
+                    recordFailure(phase, t);
+                }
+            }
+        } while (!phase.deferred.isEmpty());
+        phase.state.set(Phase.STATE_CLOSED);
+        return deferredCount;
+    }
+
+    private static void recordFailure(final Phase phase, final Throwable t) {
+        while (true) {
+            Throwable existing = phase.failure.get();
+            if (existing == null) {
+                if (phase.failure.compareAndSet(null, t)) {
+                    return;
+                }
+                // Another thread won the race; loop again to attach as suppressed.
+                continue;
+            }
+            if (existing == t) {
+                return;
+            }
+            // Try to attach t as suppressed to existing primary.
+            try {
+                existing.addSuppressed(t);
+                return;
+            } catch (Throwable ignored) {
+                // If we cannot attach, still ensure t is not lost; try to replace only if
+                // we somehow lost the primary (should not happen).
+                if (phase.failure.compareAndSet(existing, t)) {
+                    t.addSuppressed(existing);
+                    return;
+                }
+            }
+        }
+    }
+
+    /**
+     * Runs one region's ticks in vanilla order. A failed tick is never marked executed and
+     * is never retried; the failure stops this region and every other region observes the
+     * shared failure flag before starting more work. The original throwable is retained and
+     * later failures are attached as suppressed exceptions.
+     */
+    static void runRegion(final Phase phase, final List<ScheduledTick<Block>> ticks, final java.util.function.BiConsumer<BlockPos, Block> output) {
+        try {
+            for (ScheduledTick<Block> entry : ticks) {
+                if (phase.failure.get() != null) {
+                    break;
+                }
+                // Remove from pending map before execution so willTickThisTick reports
+                // correctly for the currently executing tick (vanilla semantics).
+                phase.remaining.remove(new Phase.TickKey(entry.pos().asLong(), entry.type()));
+                try {
+                    output.accept(entry.pos(), entry.type());
+                    // Only mark as executed after the handler returned normally.
+                    phase.executed.add(entry);
+                } catch (Throwable t) {
+                    recordFailure(phase, t);
+                    // Do not record the tick as executed; do not retry. Stop processing
+                    // this region to avoid cascading mutations.
+                    break;
+                }
+            }
+        } catch (Throwable t) {
+            recordFailure(phase, t);
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Shared-state access points
+    // ---------------------------------------------------------------------
+
+    /** True while a parallel region phase is active for any level. */
+    public static boolean inPhase() {
+        return ACTIVE_PHASES.get() > 0;
+    }
+
+    /** Phase-wide willTickThisTick answer for block ticks. Returns null if no active phase for this LevelTicks. */
+    public static @Nullable Boolean willTickThisTick(final LevelTicks<?> ticks, final BlockPos pos, final Object type) {
+        PhaseContext ctx = CONTEXT.get();
+        if (ctx == null) {
+            return null;
+        }
+        Phase phase = ctx.phase;
+        if (phase.blockTicks != ticks) {
+            return null;
+        }
+        // Vanilla's identity for a due tick is (type identity, position) - see
+        // ScheduledTick.UNIQUE_TICK_HASH. Ticks are removed from this map immediately
+        // before their handler runs, so the currently executing tick answers false, and
+        // every other due tick (including different types at the same position) answers
+        // correctly.
+        if (!(type instanceof Block block)) {
+            return Boolean.FALSE;
+        }
+        return Boolean.valueOf(phase.remaining.containsKey(new Phase.TickKey(pos.asLong(), block)));
+    }
+
+    /**
+     * Defers an entity addition to the post-barrier drain. Returns true when the caller
+     * should skip the immediate add (the caller reports success optimistically).
+     * Only defers when the calling thread is executing a region of THIS level's phase.
+     */
+    public static boolean deferEntityAdd(final ServerLevel level, final Entity entity) {
+        PhaseContext ctx = CONTEXT.get();
+        Runnable op = () -> level.entityManager.addNewEntity(entity);
+        if (ctx != null) {
+            // Executing inside any parallel phase: the drain always runs on the server
+            // thread, so even a cross-level add is routed there instead of running the
+            // entity manager on a worker. Admission is closed only after the phase barrier
+            // has drained (see executeRegions), so a worker can never observe a closed
+            // gate; if that invariant were ever broken, failing the phase is safer than
+            // mutating the entity manager on a worker thread.
+            if (!ctx.phase.offer(op)) {
+                throw new IllegalStateException("parallel redstone admission closed while a worker was executing");
+            }
+            return true;
+        }
+        LevelState target = level.veltisParallelRedstone;
+        if (target == null || target.closing || target.phase == null) {
+            return false;
+        }
+        return target.phase.offer(op);
+    }
+
+    /**
+     * Defers sendBlockUpdated (chunk dirty marking, path type cache, navigation recompute)
+     * to the post-barrier drain.
+     */
+    public static boolean deferBlockUpdate(final ServerLevel level, final BlockPos pos, final BlockState oldState, final BlockState newState, final int updateFlags) {
+        PhaseContext ctx = CONTEXT.get();
+        final BlockPos immutablePos = pos.immutable();
+        Runnable op = () -> level.sendBlockUpdated(immutablePos, oldState, newState, updateFlags);
+        if (ctx != null) {
+            // Same routing as deferEntityAdd: any work produced while a phase is running
+            // must execute on the server-thread drain, even if it targets another level.
+            if (!ctx.phase.offer(op)) {
+                throw new IllegalStateException("parallel redstone admission closed while a worker was executing");
+            }
+            return true;
+        }
+        LevelState target = level.veltisParallelRedstone;
+        if (target == null || target.closing || target.phase == null) {
+            return false;
+        }
+        return target.phase.offer(op);
+    }
+
+    // ---------------------------------------------------------------------
+    // Unbounded propagator tracking
+    // ---------------------------------------------------------------------
+
+    /**
+     * Conservative predicate: does this block take part in an unbounded same-tick update
+     * chain? Wire networks recompute wholesale in a single call, and fence/wall/bars/pane,
+     * rail and tripwire shape or connectivity updates chain through arbitrarily long lines
+     * without scheduling; every other reactive block (torches, diodes, observers, pistons,
+     * lamps, ...) either schedules its state change or reacts within a bounded radius.
+     * Over-inclusive answers only merge regions, which is always safe.
+     */
+    public static boolean isUnboundedPropagator(final BlockState state) {
+        if (state.isAir()) {
+            return false;
+        }
+
+        Block block = state.getBlock();
+        return block instanceof RedstoneWireBlock
+            || block instanceof FenceBlock
+            || block instanceof WallBlock
+            || block instanceof IronBarsBlock
+            || block instanceof BaseRailBlock
+            || block instanceof TripWireBlock
+            || block instanceof TripWireHookBlock;
+    }
+
+    /**
+     * True when a block change crosses the propagator boundary, which is the only case
+     * where the cached per-chunk propagator position set must be discarded. Power changes
+     * on existing propagators keep membership and leave the cache valid, so a ticking
+     * circuit never triggers a rescan.
+     */
+    public static boolean propagatorMembershipChanged(final @Nullable BlockState oldState, final BlockState newState) {
+        boolean wasPropagator = oldState != null && isUnboundedPropagator(oldState);
+        return wasPropagator != isUnboundedPropagator(newState);
+    }
+
+    /**
+     * Reads (and lazily computes, then caches on the chunk) the set of unbounded
+     * propagator positions in a chunk. Only called from the server thread before the
+     * parallel phase; workers only invalidate the cache via
+     * {@link #propagatorMembershipChanged(BlockState, BlockState)}.
+     */
+    public static LongOpenHashSet unboundedPropagatorsOf(final LevelChunk chunk) {
+        LongOpenHashSet cached = chunk.veltisUnboundedPropagators;
+        if (cached != null) {
+            return cached;
+        }
+
+        LongOpenHashSet positions = new LongOpenHashSet();
+        ChunkPos chunkPos = chunk.getPos();
+        int baseX = chunkPos.getMinBlockX();
+        int baseZ = chunkPos.getMinBlockZ();
+        int minSectionY = chunk.getMinSectionY();
+
+        LevelChunkSection[] sections = chunk.getSections();
+        for (int sectionIndex = 0; sectionIndex < sections.length; sectionIndex++) {
+            LevelChunkSection section = sections[sectionIndex];
+            if (section.hasOnlyAir() || !section.maybeHas(ParallelRedstone::isUnboundedPropagator)) {
+                continue;
+            }
+
+            int baseY = (minSectionY + sectionIndex) << 4;
+            for (int x = 0; x < 16; x++) {
+                for (int z = 0; z < 16; z++) {
+                    for (int y = 0; y < 16; y++) {
+                        if (isUnboundedPropagator(section.getBlockState(x, y, z))) {
+                            positions.add(BlockPos.asLong(baseX + x, baseY + y, baseZ + z));
+                        }
+                    }
+                }
+            }
+        }
+
+        chunk.veltisUnboundedPropagators = positions;
+        return positions;
+    }
+
+    // ---------------------------------------------------------------------
+    // Diagnostics
+    // ---------------------------------------------------------------------
+
+    /**
+     * Emits a one-line summary every {@code -Dveltis.parallelRedstoneStats=N} block-tick
+     * phases (counted across all levels) and resets the window. Disabled by default; plain
+     * server-thread longs, no cost when off beyond one field read per phase.
+     */
+    private static void maybeLogStats() {
+        synchronized (STATS_LOCK) {
+            if (STATS_INTERVAL <= 0 || !ENABLED || statTicks.incrementAndGet() < STATS_INTERVAL) {
+                return;
+            }
+            long ticks = statTicks.get();
+            long evaluated = statEvaluated.get();
+            long parallel = statParallel.get();
+            long serialSmall = statSerialSmall.get();
+            long serialSingleChunk = statSerialSingleChunk.get();
+            long serialUnverified = statSerialUnverified.get();
+            long serialSingleRegion = statSerialSingleRegion.get();
+            long serialUnauditedTick = statSerialUnauditedTick.get();
+            long serialUnsafeNeighbourhood = statSerialUnsafeNeighbourhood.get();
+            long pendingSum = statPendingSum.get();
+            long regionSum = statRegionSum.get();
+            long regionsMax = statRegionsMax.get();
+            long regionMaxTicks = statRegionMaxTicks.get();
+            long deferredSum = statDeferredSum.get();
+            long clusterNanos = statClusterNanos.get();
+            long phaseNanos = statPhaseNanos.get();
+            long collectNanos = statCollectNanos.get();
+            long groupNanos = statGroupNanos.get();
+            long workListNanos = statWorkListNanos.get();
+            long dispatchNanos = statDispatchNanos.get();
+            long workNanos = statWorkNanos.get();
+            long barrierNanos = statBarrierNanos.get();
+            long drainNanos = statDrainNanos.get();
+
+            long workListed = evaluated - serialUnverified;
+            long grouped = ticks - serialSmall;
+            double averagePending = evaluated == 0 ? 0.0 : Math.round((double) pendingSum / evaluated * 10.0) / 10.0;
+            double averageRegions = parallel == 0 ? 0.0 : Math.round((double) regionSum / parallel * 100.0) / 100.0;
+            double averageCollectUs = ticks == 0 ? 0.0 : Math.round((double) collectNanos / ticks / 1_000.0 * 10.0) / 10.0;
+            double averageGroupUs = grouped <= 0 ? 0.0 : Math.round((double) groupNanos / grouped / 1_000.0 * 10.0) / 10.0;
+            double averageClusterUs = evaluated == 0 ? 0.0 : Math.round((double) clusterNanos / evaluated / 1_000.0 * 10.0) / 10.0;
+            double averageWorkListUs = workListed <= 0 ? 0.0 : Math.round((double) workListNanos / workListed / 1_000.0 * 10.0) / 10.0;
+            double averageDispatchUs = parallel == 0 ? 0.0 : Math.round((double) dispatchNanos / parallel / 1_000.0 * 10.0) / 10.0;
+            double averageWorkUs = parallel == 0 ? 0.0 : Math.round((double) workNanos / parallel / 1_000.0 * 10.0) / 10.0;
+            double averageBarrierUs = parallel == 0 ? 0.0 : Math.round((double) barrierNanos / parallel / 1_000.0 * 10.0) / 10.0;
+            double averageDrainUs = parallel == 0 ? 0.0 : Math.round((double) drainNanos / parallel / 1_000.0 * 10.0) / 10.0;
+            double averageDeferred = parallel == 0 ? 0.0 : Math.round((double) deferredSum / parallel * 10.0) / 10.0;
+            double averagePhaseUs = parallel == 0 ? 0.0 : Math.round((double) phaseNanos / parallel / 1_000.0 * 10.0) / 10.0;
+
+            STATS_LOGGER.info(
+                "last {} block-tick phases: parallel={} serialSmall={} serialSingleChunk={} serialUnverified={} serialSingleRegion={} serialUnauditedTick={} serialUnsafeNeighbourhood={} avgPending={} avgRegions={} maxRegions={} maxRegionTicks={} avgCollectUs={} avgGroupUs={} avgClusterUs={} avgWorkListUs={} avgDispatchUs={} avgWorkUs={} avgBarrierUs={} avgDrainUs={} avgDeferred={} avgPhaseUs={}",
+                ticks,
+                parallel,
+                serialSmall,
+                serialSingleChunk,
+                serialUnverified,
+                serialSingleRegion,
+                serialUnauditedTick,
+                serialUnsafeNeighbourhood,
+                averagePending,
+                averageRegions,
+                regionsMax,
+                regionMaxTicks,
+                averageCollectUs,
+                averageGroupUs,
+                averageClusterUs,
+                averageWorkListUs,
+                averageDispatchUs,
+                averageWorkUs,
+                averageBarrierUs,
+                averageDrainUs,
+                averageDeferred,
+                averagePhaseUs
+            );
+
+            statTicks.set(0);
+            statEvaluated.set(0);
+            statParallel.set(0);
+            statSerialSmall.set(0);
+            statSerialSingleChunk.set(0);
+            statSerialUnverified.set(0);
+            statSerialSingleRegion.set(0);
+            statSerialUnauditedTick.set(0);
+            statSerialUnsafeNeighbourhood.set(0);
+            statPendingSum.set(0);
+            statRegionSum.set(0);
+            statRegionsMax.set(0);
+            statRegionMaxTicks.set(0);
+            statDeferredSum.set(0);
+            statClusterNanos.set(0);
+            statPhaseNanos.set(0);
+            statCollectNanos.set(0);
+            statGroupNanos.set(0);
+            statWorkListNanos.set(0);
+            statDispatchNanos.set(0);
+            statWorkNanos.set(0);
+            statBarrierNanos.set(0);
+            statDrainNanos.set(0);
+        }
+    }
