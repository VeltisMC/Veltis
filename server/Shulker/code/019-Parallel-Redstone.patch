     @Override
     public @Nullable ChunkAccess getChunk(final int x, final int z, final ChunkStatus targetStatus, final boolean loadOrGenerate) {
         if (Thread.currentThread() != this.mainThread) {
+            // Veltis parallel redstone: non-blocking fast path for worker threads.
+            //
+            // Lifetime guarantee: this path is only reachable while THIS level has a
+            // registered parallel phase (ParallelRedstone.isPhaseActiveFor). During that
+            // window the level's main thread is either executing a region or parked in the
+            // phase barrier pumping this very executor; it is not running ChunkMap.tick(),
+            // processUnloads(), level unload, or holder eviction, which are the only code
+            // paths that demote/remove a published chunk. Region discovery additionally
+            // requires the requested chunk and its whole 5x5 audit window to be loaded at
+            // FULL, and FULL publication is monotonic, so a returned LevelChunk stays the
+            // same object for the duration of the phase. The fast path itself never
+            // creates, promotes, loads or stores anything; any miss (mid-promotion,
+            // unloaded, outside a phase) falls through to the vanilla main-thread
+            // roundtrip, which remains the single writer for all lifecycle state.
+            if (org.veltismc.redstone.ParallelRedstone.isPhaseActiveFor(this.level)) {
+                long fastPos = ChunkPos.pack(x, z);
+                ChunkHolder fastHolder = this.getVisibleChunkIfPresent(fastPos);
+                if (fastHolder != null) {
+                    ChunkAccess fastChunk = fastHolder.getChunkIfPresent(targetStatus);
+                    if (fastChunk != null) {
+                        return fastChunk;
+                    }
+                }
+            }
+
             return CompletableFuture.<ChunkAccess>supplyAsync(() -> this.getChunk(x, z, targetStatus, loadOrGenerate), this.mainThreadProcessor).join();
         }
 

