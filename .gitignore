# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war

# OS
.DS_Store
Thumbs.db

# Environment
*.log
.env
local.properties

# Build artifacts
out/
tmp/
*.userdata
run/

# The Minecraft pipeline development cache. Everything here is reproducible with
# `./gradlew prepareMinecraft`, and none of it belongs in version control: the
# pristine decompile at `minecraft/<version>/` (only the decompile step writes
# it) and the workspace at `minecraft/workspace/<version>/`. It lives outside
# `build/` deliberately — neither `./gradlew clean` nor an IDE's blanket build/
# exclusion may hide the tree the toolchain reads.
/minecraft/
#
# A server install started from the repository root — `java -jar server.jar`
# with the checkout as the working directory — lays out Vanilla/ and Veltis/
# beside it, exactly as it would beside a real server. Ignored here for the same
# reason: generated, reproducible, not source.
/Vanilla/
/Veltis/

# Staging files left behind by an interrupted write. They are always deleted
# before a run continues, so seeing one committed would mean a broken run.
# There are exactly two, both derived from the target file's own name rather
# than generated, so a crashed run leaves one predictable path to look at:
#   .writing   a patched file being replaced
#   .widening  the access-widened jar being built
#   .building  a patch file being renumbered (deleted if the run is interrupted)
*.writing
*.widening
*.building

# Launcher server home (booting from the repo root pollutes it; prefer
# `java -jar veltismc.jar --home run`, whose output is already ignored above)
/eula.txt
/server.properties
/logs/
/config/

# ---------------------------------------------------------------------------
# Native module: generated build state, never source.
#
# `build/` above already hides the CMake trees Gradle uses
# (`native/build/native/...`). What follows catches a configure step pointed
# somewhere else, because CMake scatters state across several file names rather
# than into one directory, and a compiler-identification run leaves executables
# nobody asked for. The source archive is built from `git ls-files`, so anything
# that has to stay out of it has to be ignored here first.
# ---------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/
DartConfiguration.tcl
# A CMake configure step compiles and runs these before it knows your compiler.
CMakeCCompilerId.c
CMakeCCompilerId.cpp
CMakeCCompilerId
CMakeCXXCompilerId.cpp
CMakeDetermineCompilerABI_*.bin
# Ninja's own output, and the artefacts of one build directory.
build.ninja
.ninja_deps
.ninja_log
rules.ninja
# Object files and static archives, whichever suffix the toolchain prefers.
*.o
*.obj
*.a
*.lib
# Locally built shared libraries. A released artifact is distributed from CI,
# so nothing in the source tree has any business being one.
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.dSYM/
# Native release archives and local verification output, including a previous
# release's — they are derived from a commit, so the commit rebuilds them.
/native-*.zip
native/out/
native/native/
native/*.zip.sha256
native/reports/
