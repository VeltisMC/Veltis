<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="TerminalConsole" target="SYSTEM_OUT" follow="true">
            <PatternLayout pattern="%highlight{[%d{HH:mm:ss} %level]: %msg%n}{FATAL=red, ERROR=red, WARN=yellow, INFO=white, DEBUG=cyan}" charset="UTF-8"/>
        </Console>
        <RollingRandomAccessFile name="File" fileName="logs/latest.log"
            filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="[%d{HH:mm:ss} %level]: %msg%n" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
            </Policies>
        </RollingRandomAccessFile>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="TerminalConsole"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
