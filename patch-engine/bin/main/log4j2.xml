<?xml version="1.0" encoding="UTF-8"?>
<!-- Console-only config for the pipeline's JVMs (each Gradle JavaExec
     step runs in its own JVM). Same pattern as the server so every phase and
     completion message reads identically in the Gradle output. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="TerminalConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss} %level]: %msg%n" charset="UTF-8"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="TerminalConsole"/>
        </Root>
    </Loggers>
</Configuration>
